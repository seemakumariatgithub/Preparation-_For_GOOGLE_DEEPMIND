KOKO EATING BANANAS:
class Solution {
    public int minEatingSpeed(int[] piles, int h) {

        int left =1; // selecting minimum
        int right=0;// selecting maximum

        for(int pile:piles){
            right=Math.max(pile,right);
        }
        while(left<right){
        int mid=left+(right-left)/2;
        long hour=totalHour(piles,mid);

        if(hour<=h){
            right=mid;
        }else{
            left=mid+1;
        }
    }
        return left;
    }

    private long totalHour(int[] piles, int midSpeed){
        long totalHour=0;
        for(int pile:piles){
            totalHour+=(pile+midSpeed-1)/midSpeed;
        }
        return totalHour;
    }
}

