Complete Algorithm

                Now you have all the pieces.
                
                For every index i:
                
                                While current bar is smaller or equal:
                                while (!stack.isEmpty()
                                        && heights[stack.peek()] >= heights[i])

                    Pop the previous bar.
                    
                    For the popped bar:
                                    height = heights[popped]
                                    right = i
                                    left = stack.isEmpty() ? -1 : stack.peek()
                                    
                                    width = right - left - 1
                                    
                                    area = height * width

                    Update maximum area.
                    
                    Then push current index.

At the end, there may still be bars in the stack.

            Those bars have no smaller element to their right, so we use:   right = n

            and calculate their areas.


================================================================================================================================================
            import java.util.ArrayDeque;
            import java.util.Deque;
            
            class Solution {            
                public int largestRectangleArea(int[] heights) {            
                    int n = heights.length;
                    int maxArea = 0;            
                    Deque<Integer> stack = new ArrayDeque<>();            
                    for (int i = 0; i < n; i++) {            
                        while (!stack.isEmpty()
                                && heights[stack.peek()] >= heights[i]) {            
                            int height = heights[stack.pop()];            
                            int right = i;
                            int left = stack.isEmpty() ? -1 : stack.peek();            
                            int width = right - left - 1;            
                            maxArea = Math.max(maxArea, height * width);
                        }            
                        stack.push(i);
                    }            
                    // Process remaining bars
                    while (!stack.isEmpty()) {            
                        int height = heights[stack.pop()];            
                        int right = n;
                        int left = stack.isEmpty() ? -1 : stack.peek();            
                        int width = right - left - 1;            
                        maxArea = Math.max(maxArea, height * width);
                    }            
                    return maxArea;
                }
            }




