import java.util.Objects;

public final class InsurancePolicy {

    private final String customerId;
    private final String policyType;
    private final String nominee;
    private final boolean roadsideAssistance;
    private final double discountPercentage;

    private InsurancePolicy(Builder builder) {
        this.customerId = builder.customerId;
        this.policyType = builder.policyType;
        this.nominee = builder.nominee;
        this.roadsideAssistance = builder.roadsideAssistance;
        this.discountPercentage = builder.discountPercentage;
    }

    public static Builder builder() {
        return new Builder();
    }

    public static final class Builder {
        private String customerId;
        private String policyType;
        private String nominee;
        private boolean roadsideAssistance;
        private double discountPercentage;

        public Builder customerId(String customerId) {
            this.customerId = customerId;
            return this;
        }

        public Builder policyType(String policyType) {
            this.policyType = policyType;
            return this;
        }

        public Builder nominee(String nominee) {
            this.nominee = nominee;
            return this;
        }

        public Builder roadsideAssistance(boolean enabled) {
            this.roadsideAssistance = enabled;
            return this;
        }

        public Builder discountPercentage(double discount) {
            this.discountPercentage = discount;
            return this;
        }

        public InsurancePolicy build() {
            Objects.requireNonNull(customerId, "customerId");
            Objects.requireNonNull(policyType, "policyType");

            if (discountPercentage < 0
                    || discountPercentage > 100) {
                throw new IllegalArgumentException(
                    "Discount must be between 0 and 100");
            }

            return new InsurancePolicy(this);
        }
    }
}


